<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.carview.hud"
    android:versionCode="14"
    android:versionName="0.6">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Only used for the outside temperature (Open-Meteo, coarse location). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- "Call Alex": names and numbers are looked up on the head unit only, never sent anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:label="CarView"
        android:icon="@drawable/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- The dashboard itself: a normal, resizeable task so it can share the screen with Google Maps. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen entry point: forwards to the dashboard. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Reads Spotify's media session and Google Maps' turn-by-turn notification. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="CarView media and navigation"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
